# Copia este archivo como `keystore.properties` (misma carpeta) y completa tus datos.
# Para la entrega de la evaluación, `keystore.properties` y el .jks se suben al repositorio (lo pide la pauta):
# usa una llave desechable creada solo para este trabajo y una contraseña que no uses en ningún otro lugar.
storeFile=albalab-release.jks
storePassword=CAMBIAR
keyAlias=albalab
