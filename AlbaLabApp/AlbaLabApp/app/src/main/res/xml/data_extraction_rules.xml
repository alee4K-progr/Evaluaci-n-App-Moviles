<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Los datos de usuarios (hash de clave) y fotos no se respaldan en la nube -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="fotos/" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="fotos/" />
    </device-transfer>
</data-extraction-rules>
